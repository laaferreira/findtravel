# ======================================================
# resort-price-hunter — exemplo de variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# ======================================================

# Provider de viagem: "mock" ou "decolar"
TRAVEL_PROVIDER=mock

# Supabase (service role usada SOMENTE no backend/CI — nunca no frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Playwright / Chromium
HEADLESS=true

# Controle de carga
MAX_SEARCHES_PER_RUN=20
DELAY_BETWEEN_SEARCHES_MS=4000
NAVIGATION_TIMEOUT_MS=45000

# Diretório de artefatos de diagnóstico (screenshots/logs em caso de erro)
ARTIFACTS_DIR=artifacts
